# --- QUESTLOG server environment (copy to .env and fill in) ---

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Database file path (created automatically on first boot).
DATABASE_PATH=./data/questlog.db

# Used to sign session tokens. PRODUCTION: use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="super-do-not-forget-to-change-me"

# How long a session lasts before the user must log in again (default 30 days).
SESSION_TTL_DAYS=30

# Origin of the client app (used for the CORS allow-list in production).
CLIENT_ORIGIN="http://localhost:5173"